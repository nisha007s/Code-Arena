{
  "name": "code-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Coding practice library and real-time 1v1 arena with a Docker judge and an explainable recommender.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "start:lan": "node --disable-warning=ExperimentalWarning server/index.js --lan",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "judge:build": "node scripts/build-images.js",
    "judge:smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-judge.js",
    "check:starters": "node --disable-warning=ExperimentalWarning scripts/check-starters.js",
    "check:catalog": "node --disable-warning=ExperimentalWarning scripts/verify-catalog.js",
    "fixtures": "node scripts/generate-fixtures.js",
    "e2e": "node --disable-warning=ExperimentalWarning scripts/e2e-browser.js",
    "verify": "npm test && npm run check:catalog",
    "postinstall": "node scripts/generate-fixtures.js --check",
    "check:integration": "npm run judge:smoke && npm run judge:sandbox && npm run check:starters && npm run e2e",
    "judge:sandbox": "node --disable-warning=ExperimentalWarning scripts/verify-sandbox.js",
    "check:references": "node --disable-warning=ExperimentalWarning scripts/check-references.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "socket.io-client": "^4.8.1"
  }
}
